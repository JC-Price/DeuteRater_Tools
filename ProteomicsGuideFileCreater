def multi_charged_peptides(row):
    min_charge = 2
    max_charge = 6
    results = []

    # Extract the original values to keep the entire row
    original_row = row._asdict()  # Convert namedtuple to dictionary
    neutral_mass = (original_row['Observed_Mass']) 
    predict_neutral_mass = int(original_row['Calibrated_Observed_Mass']) 

    for n in range(min_charge, max_charge + 1):
        # Create a copy of the original row
        new_row = original_row.copy()

        # Update the specific columns
        new_row['Identification_Charge'] = n
        new_row['Precursor_m_z'] = (neutral_mass + n * 1.007276) / n
        new_row['Calibrated_Observed_M_Z'] = (predict_neutral_mass + n * 1.007276) / n
        
        results.append(new_row)

        # Filter out rows with low m/z
        if new_row['Precursor_m_z'] < 350:
            results.remove(new_row)

    return results

