# Function to cluster retention times within 180 seconds
def cluster_peptides(group):
    clustered = []
    current_cluster = []

    for i, row in group.iterrows():
        if not current_cluster:
            current_cluster.append(row)
        else:     # RT window currently set to 180 sec. Change if desired
            if abs(row['Precursor Retention Time (sec)'] - current_cluster[-1]['Precursor Retention Time (sec)']) <= 180:
                current_cluster.append(row)
            else:
                clustered.append(current_cluster)
                current_cluster = [row]

    if current_cluster:
        clustered.append(current_cluster)

    # Calculate mean for each cluster
    clustered_data = []
    for cluster in clustered:
        cluster_df = pd.DataFrame(cluster)
        mean_row = cluster_df.mean(numeric_only=True)
        for col in cluster_df.columns:
            if cluster_df[col].dtype == 'object':  # Preserve string columns by taking the first value
                mean_row[col] = cluster_df[col].iloc[0]
        clustered_data.append(mean_row)

    return pd.DataFrame(clustered_data)

