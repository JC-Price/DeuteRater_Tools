def _interpret_aa_sequences(df, sequence_column_name):
    # Load required resources
    aa_comp_df = pd.read_csv(aa_elem_comp, sep='\t')
    aa_comp_df.set_index('amino_acid', inplace=True)

    elem_df = pd.read_csv(elems_path, sep='\t')
    element_index_mask = [0, 10, 13, 15, 30, 31]  # Indexes for specific isotopes
    elem_df = elem_df.iloc[element_index_mask]
    elem_df.set_index('isotope_letter', inplace=True)

    # Loop through each row in the DataFrame
    for row in df.itertuples():
        sequence = getattr(row, sequence_column_name)
        aa_counts = {}

        # Count amino acid occurrences
        for aa in sequence:
            aa_counts[aa] = aa_counts.get(aa, 0) + 1

        # Calculate the elemental composition
        elem_dict = calc_cf(aa_counts, aa_comp_df)

        cff = ''.join(k + str(v) for k, v in elem_dict.items() if v > 0)
        # Assign the calculated values to the DataFrame
        df.at[row.Index, 'cf'] = cff

    return df  # Optionally return the updated DataFrame


def add_adduct_column(df):

    # helper function to add the charge to the chemical formula. Is applied to each row in the df
    def increment_cf(row):
        cf_value = row['cf']

        # Use regex to find the number after 'H'
        match = re.search(r'H(\d+)', cf_value)
        if match:
            # Extract the current number after 'H'
            current_h_value = int(match.group(1))
            # Increment it by the value in 'Identification Charge'
            new_h_value = current_h_value + row['Identification Charge']
            # Replace the old value with the new value in the cf string
            new_cf_value = cf_value.replace(f'H{current_h_value}', f'H{new_h_value}')
            return new_cf_value

        return cf_value

    df['Adduct_cf'] = df.apply(increment_cf, axis=1)

    return df


